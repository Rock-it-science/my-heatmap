		"@fastify/session": "^11.1.1",
		"@fastify/static": "^8.3.0",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@jest/types": "^30.2.0",
		"@mapbox/polyline": "^1.2.1",
		"@prisma/client": "^6.19.0",
		"@sinclair/typebox": "^0.34.48",

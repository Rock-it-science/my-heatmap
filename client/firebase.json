{
	"hosting": {
		"public": "dist",
		"rewrites": [
			{
				"source": "/api/**",
				"run": {
					"serviceId": "my-heatmap",
					"region": "us-central1"
				}
			},
			{
				"source": "**",
				"destination": "/index.html"
			}
		],
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
	}
}
